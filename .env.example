# ──────────────────────────────────────────────────────────────
# OptionSentinel Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Alpaca Trading API Keys (Paper Trading)
# Use your dedicated hackathon paper account.
APCA_API_KEY_ID=YOUR_ALPACA_PAPER_KEY_ID_HERE
APCA_API_SECRET_KEY=YOUR_ALPACA_PAPER_SECRET_KEY_HERE

# Alpaca Environment & Execution Mode
# ALPACA_ENV: paper or live. Keep "paper" for hackathon.
ALPACA_ENV=paper

# EXECUTION_MODE options:
#   DRY_RUN                 -> Mock data, no orders
#   PAPER_SIMULATION        -> Mock data, no orders
#   PAPER_MANUAL_APPROVAL   -> Real paper data, no orders (waits for manual approval)
#   PAPER_AUTONOMOUS        -> Real paper data, automatically submits approved trades
#   LIVE                    -> Hard-blocked, do not use
EXECUTION_MODE=DRY_RUN

# Live trading must always be false for hackathon
ALPACA_LIVE_TRADING_CONFIRMED=false

# Optional API base URLs (usually not needed)
# APCA_API_BASE_URL=https://paper-api.alpaca.markets
# APCA_API_DATA_URL=https://data.alpaca.markets

# ──────────────────────────────────────────────────────────────
# Featherless AI (Optional) – LLM Explanation Layer
# Get API key from https://featherless.ai/
# If not set, system falls back to template explanations.
# ──────────────────────────────────────────────────────────────
FEATHERLESS_API_KEY=YOUR_FEATHERLESS_API_KEY_HERE
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Choose an open model available on Featherless
# Examples: mistralai/Mistral-7B-Instruct-v0.3, meta-llama/Meta-Llama-3-8B-Instruct
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# ──────────────────────────────────────────────────────────────
# Other settings (if needed)
# DEPLOY_STAGE=DEV

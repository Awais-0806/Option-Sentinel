# ── Environment ──────────────────────────────────────────────
# This build is paper-only. LIVE execution is hard-blocked regardless of
# configuration, so keep this paper default unchanged.
ALPACA_ENV=paper

# ── Alpaca credentials (paper) ───────────────────────────────
# Standard Alpaca environment variable names. Replace both placeholders
# only when using PAPER_MANUAL_APPROVAL or PAPER_AUTONOMOUS.
APCA_API_KEY_ID=your_paper_api_key_here
APCA_API_SECRET_KEY=your_paper_secret_key_here
# Legacy aliases are also supported: ALPACA_API_KEY and ALPACA_SECRET_KEY.
# Use either credential scheme, not both.

# ── Deployment stage (dev | staging | competition) ───────────
# Controls which DB file / journal namespace is used. The
# "competition" stage should point at a brand-new paper account
# created specifically for the hackathon submission.
DEPLOY_STAGE=dev

# ── Execution mode ────────────────────────────────────────────
# DRY_RUN               -> mock data, mock account, nothing touches Alpaca (default)
# PAPER_SIMULATION       -> same as DRY_RUN today; reserved for a future dedicated
#                           simulation adapter that prices against real quotes
# PAPER_MANUAL_APPROVAL  -> REAL Alpaca paper account; requires ALPACA_API_KEY/
#                           ALPACA_SECRET_KEY; builds+risk-checks real trades but
#                           stops before submission and waits for your approval
# PAPER_AUTONOMOUS       -> REAL Alpaca paper account; approved trades submit
#                           automatically. Requires explicit opt-in. Never the default.
# LIVE                   -> hard-blocked in this build, unconditionally.
#
# Default MUST remain DRY_RUN. The operator switches modes explicitly.
EXECUTION_MODE=DRY_RUN

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/optionsentinel_dev.db

# ── Risk limits (all configurable, no hard-coded assumptions) ─
MAX_PORTFOLIO_RISK_PCT=0.06
MAX_TRADE_RISK_PCT=0.015
MAX_DAILY_LOSS_PCT=0.03
MAX_DRAWDOWN_PCT=0.10
MAX_OPEN_POSITIONS=8
MAX_POSITION_CONCENTRATION_PCT=0.20
MAX_BID_ASK_SPREAD_PCT=0.12
MIN_OPEN_INTEREST=50
MIN_OPTION_VOLUME=10
STALE_QUOTE_SECONDS=60

# ── Trade scoring thresholds (configurable) ───────────────────
SCORE_NO_TRADE_MAX=60
SCORE_SMALL_SIZE_MAX=70
SCORE_NORMAL_SIZE_MAX=85

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Underlyings to scan (comma separated) ──────────────────────
WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA
